<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="hackwars-data" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>com.hackwars.data.entity.hackwars.NetworkEntity</class>
        <class>com.hackwars.data.entity.hackwars.AttachedNetworkEntity</class>
        <class>com.hackwars.data.entity.hackwars.AttachedNetworkId</class>
        <class>com.hackwars.data.entity.hackwars.NetworkNpcEntity</class>
        <class>com.hackwars.data.entity.hackwars.NetworkNpcId</class>

        <class>com.hackwars.data.entity.hackwars.DomainEntity</class>
        <class>com.hackwars.data.entity.hackwars.DropTableEntryEntity</class>
        <class>com.hackwars.data.entity.hackwars.DropTableEntryId</class>
        <class>com.hackwars.data.entity.hackwars.ItemEntity</class>

        <class>com.hackwars.data.entity.hackwars.UserSaveEntity</class>
        <class>com.hackwars.data.entity.hackwars.UserPlayStatisticEntity</class>
        <class>com.hackwars.data.entity.hackwars.UserPlayStatisticId</class>
        <class>com.hackwars.data.entity.hackwars.BoughtItemEntity</class>

        <class>com.hackwars.data.entity.hackerforum.ForumUserEntity</class>
        <class>com.hackwars.data.entity.hackwarsdrupal.DrupalUserEntity</class>

        <class>com.hackwars.data.entity.alexchat.ChatUserEntity</class>
        <class>com.hackwars.data.entity.alexchat.ChatUserRelationEntity</class>
        <class>com.hackwars.data.entity.alexchat.ChatUserRelationId</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="com.mysql.cj.jdbc.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:mysql://127.0.0.1:3306/hackwars"/>
            <property name="jakarta.persistence.jdbc.user" value="root"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.show_sql" value="false"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.MySQLDialect"/>
        </properties>
    </persistence-unit>
</persistence>
