<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
      http://www.liquibase.org/xml/ns/dbchangelog
      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="rewrite-0001-bootstrap-schema" author="codex">
        <comment>Bootstrap the rewrite persistence schema with event, snapshot, account, computer, and import batch tables.</comment>

        <createTable tableName="rewrite_import_batch">
            <column name="batch_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="source_kind" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="source_location" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="seed_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="rewrite_player_account">
            <column name="player_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="playfab_id" type="varchar(128)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="player_ip" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="account_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="rewrite_computer_state">
            <column name="computer_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="ip_address" type="varchar(64)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="state_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="rewrite_state_event">
            <column name="stream_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="sequence_number" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="recorded_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="rewrite_state_event"
            columnNames="stream_id, sequence_number"
            constraintName="pk_rewrite_state_event"/>

        <createTable tableName="rewrite_state_snapshot">
            <column name="stream_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="version" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="recorded_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="rewrite_state_snapshot"
            columnNames="stream_id, version"
            constraintName="pk_rewrite_state_snapshot"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_computer_state"
            baseColumnNames="player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_computer_player"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_state_event"
            baseColumnNames="stream_id"
            referencedTableName="rewrite_computer_state"
            referencedColumnNames="computer_id"
            constraintName="fk_rewrite_event_computer"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_state_snapshot"
            baseColumnNames="stream_id"
            referencedTableName="rewrite_computer_state"
            referencedColumnNames="computer_id"
            constraintName="fk_rewrite_snapshot_computer"/>

        <rollback>
            <dropTable tableName="rewrite_state_snapshot"/>
            <dropTable tableName="rewrite_state_event"/>
            <dropTable tableName="rewrite_computer_state"/>
            <dropTable tableName="rewrite_player_account"/>
            <dropTable tableName="rewrite_import_batch"/>
        </rollback>
    </changeSet>

    <changeSet id="rewrite-0002-world-directory" author="codex">
        <comment>Persist rewrite-owned network definitions, attached links, and NPC directory rows.</comment>

        <createTable tableName="rewrite_network_directory">
            <column name="network_name" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="store_state_id" type="varchar(64)"/>
        </createTable>

        <createTable tableName="rewrite_network_link">
            <column name="from_network_name" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="to_network_name" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="entrance_message" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="failure_message" type="text">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="rewrite_network_link"
            columnNames="from_network_name, to_network_name"
            constraintName="pk_rewrite_network_link"/>

        <createTable tableName="rewrite_network_npc">
            <column name="network_name" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="state_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="varchar(128)"/>
            <column name="category" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="commodity" type="varchar(128)"/>
            <column name="sort_order" type="integer">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="rewrite_network_npc"
            columnNames="network_name, state_id"
            constraintName="pk_rewrite_network_npc"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_network_link"
            baseColumnNames="from_network_name"
            referencedTableName="rewrite_network_directory"
            referencedColumnNames="network_name"
            constraintName="fk_rewrite_network_link_from"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_network_link"
            baseColumnNames="to_network_name"
            referencedTableName="rewrite_network_directory"
            referencedColumnNames="network_name"
            constraintName="fk_rewrite_network_link_to"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_network_npc"
            baseColumnNames="network_name"
            referencedTableName="rewrite_network_directory"
            referencedColumnNames="network_name"
            constraintName="fk_rewrite_network_npc_network"/>

        <createIndex tableName="rewrite_network_npc" indexName="idx_rewrite_network_npc_sort">
            <column name="network_name"/>
            <column name="category"/>
            <column name="sort_order"/>
        </createIndex>

        <rollback>
            <dropTable tableName="rewrite_network_npc"/>
            <dropTable tableName="rewrite_network_link"/>
            <dropTable tableName="rewrite_network_directory"/>
        </rollback>
    </changeSet>

    <changeSet id="rewrite-0003-auth-session" author="codex">
        <comment>Persist retained auth tickets and authenticated service sessions for GAME and CHAT bootstrap flows.</comment>

        <createTable tableName="rewrite_session_ticket">
            <column name="session_ticket" type="varchar(191)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="playfab_id" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="player_ip" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="issued_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="timestamptz"/>
            <column name="ticket_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="rewrite_service_session">
            <column name="service_session_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="service_kind" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="connection_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="playfab_id" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="player_ip" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="session_ticket" type="varchar(191)">
                <constraints nullable="false"/>
            </column>
            <column name="client_build" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="heartbeat_interval_millis" type="bigint">
                <constraints nullable="false"/>
            </column>
            <column name="authenticated_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="last_seen_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="closed_at" type="timestamptz"/>
            <column name="session_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="rewrite_session_ticket"
            baseColumnNames="player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_ticket_player"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_service_session"
            baseColumnNames="player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_service_session_player"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_service_session"
            baseColumnNames="session_ticket"
            referencedTableName="rewrite_session_ticket"
            referencedColumnNames="session_ticket"
            constraintName="fk_rewrite_service_session_ticket"/>

        <addUniqueConstraint
            tableName="rewrite_service_session"
            columnNames="service_kind, connection_id"
            constraintName="uq_rewrite_service_session_connection"/>

        <createIndex tableName="rewrite_session_ticket" indexName="idx_rewrite_session_ticket_player">
            <column name="player_id"/>
        </createIndex>

        <createIndex tableName="rewrite_session_ticket" indexName="idx_rewrite_session_ticket_playfab">
            <column name="playfab_id"/>
        </createIndex>

        <createIndex tableName="rewrite_service_session" indexName="idx_rewrite_service_session_player">
            <column name="player_id"/>
            <column name="service_kind"/>
            <column name="closed_at"/>
        </createIndex>

        <createIndex tableName="rewrite_service_session" indexName="idx_rewrite_service_session_ticket">
            <column name="session_ticket"/>
        </createIndex>

        <rollback>
            <dropTable tableName="rewrite_service_session"/>
            <dropTable tableName="rewrite_session_ticket"/>
        </rollback>
    </changeSet>

    <changeSet id="rewrite-0004-chat-social" author="codex">
        <comment>Persist retained chat channels, moderation membership, history, relations, mutes, and online presence.</comment>

        <createTable tableName="rewrite_chat_channel">
            <column name="channel_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="display_name" type="varchar(128)">
                <constraints nullable="false"/>
            </column>
            <column name="topic" type="text">
                <constraints nullable="false"/>
            </column>
            <column name="owner_player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="private_channel" type="boolean">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="channel_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="rewrite_chat_channel_member">
            <column name="channel_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="role" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="membership_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="rewrite_chat_channel_member"
            columnNames="channel_id, player_id"
            constraintName="pk_rewrite_chat_channel_member"/>

        <createTable tableName="rewrite_chat_message">
            <column name="message_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="message_kind" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="channel_id" type="varchar(64)"/>
            <column name="sender_player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="recipient_player_id" type="varchar(64)"/>
            <column name="event_type" type="varchar(32)">
                <constraints nullable="false"/>
            </column>
            <column name="payload" type="bytea">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createTable tableName="rewrite_chat_relation">
            <column name="player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="target_player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="relation_kind" type="varchar(16)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="relation_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="rewrite_chat_relation"
            columnNames="player_id, target_player_id, relation_kind"
            constraintName="pk_rewrite_chat_relation"/>

        <createTable tableName="rewrite_chat_channel_mute">
            <column name="player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="channel_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="muted_player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="mute_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addPrimaryKey
            tableName="rewrite_chat_channel_mute"
            columnNames="player_id, channel_id, muted_player_id"
            constraintName="pk_rewrite_chat_channel_mute"/>

        <createTable tableName="rewrite_chat_presence">
            <column name="connection_id" type="varchar(64)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="player_id" type="varchar(64)">
                <constraints nullable="false"/>
            </column>
            <column name="online_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="last_seen_at" type="timestamptz">
                <constraints nullable="false"/>
            </column>
            <column name="offline_at" type="timestamptz"/>
            <column name="presence_payload" type="jsonb">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_channel"
            baseColumnNames="owner_player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_channel_owner"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_channel_member"
            baseColumnNames="channel_id"
            referencedTableName="rewrite_chat_channel"
            referencedColumnNames="channel_id"
            constraintName="fk_rewrite_chat_member_channel"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_channel_member"
            baseColumnNames="player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_member_player"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_message"
            baseColumnNames="channel_id"
            referencedTableName="rewrite_chat_channel"
            referencedColumnNames="channel_id"
            constraintName="fk_rewrite_chat_message_channel"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_message"
            baseColumnNames="sender_player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_message_sender"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_message"
            baseColumnNames="recipient_player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_message_recipient"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_relation"
            baseColumnNames="player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_relation_player"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_relation"
            baseColumnNames="target_player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_relation_target"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_channel_mute"
            baseColumnNames="player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_mute_player"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_channel_mute"
            baseColumnNames="channel_id"
            referencedTableName="rewrite_chat_channel"
            referencedColumnNames="channel_id"
            constraintName="fk_rewrite_chat_mute_channel"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_channel_mute"
            baseColumnNames="muted_player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_mute_target"/>

        <addForeignKeyConstraint
            baseTableName="rewrite_chat_presence"
            baseColumnNames="player_id"
            referencedTableName="rewrite_player_account"
            referencedColumnNames="player_id"
            constraintName="fk_rewrite_chat_presence_player"/>

        <createIndex tableName="rewrite_chat_channel_member" indexName="idx_rewrite_chat_member_role">
            <column name="channel_id"/>
            <column name="role"/>
            <column name="joined_at"/>
        </createIndex>

        <createIndex tableName="rewrite_chat_message" indexName="idx_rewrite_chat_message_channel">
            <column name="channel_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="rewrite_chat_message" indexName="idx_rewrite_chat_message_whisper">
            <column name="recipient_player_id"/>
            <column name="created_at"/>
        </createIndex>

        <createIndex tableName="rewrite_chat_relation" indexName="idx_rewrite_chat_relation_kind">
            <column name="player_id"/>
            <column name="relation_kind"/>
        </createIndex>

        <createIndex tableName="rewrite_chat_channel_mute" indexName="idx_rewrite_chat_mute_lookup">
            <column name="player_id"/>
            <column name="channel_id"/>
        </createIndex>

        <createIndex tableName="rewrite_chat_presence" indexName="idx_rewrite_chat_presence_player">
            <column name="player_id"/>
            <column name="offline_at"/>
            <column name="online_at"/>
        </createIndex>

        <rollback>
            <dropTable tableName="rewrite_chat_presence"/>
            <dropTable tableName="rewrite_chat_channel_mute"/>
            <dropTable tableName="rewrite_chat_relation"/>
            <dropTable tableName="rewrite_chat_message"/>
            <dropTable tableName="rewrite_chat_channel_member"/>
            <dropTable tableName="rewrite_chat_channel"/>
        </rollback>
    </changeSet>
</databaseChangeLog>
